{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vite-plugin-pwa/react"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@sq/ui": ["../../packages/ui/src/index.tsx"],
      "@sq/core/gamification": ["../../packages/core/src/gamification/index.ts"],
      "@sq/core/progress": ["../../packages/core/src/progress/index.ts"],
      "@sq/core/subjects": ["../../packages/core/src/subjects/index.ts"],
      "@sq/core/schemas/subjects": ["../../packages/core/src/schemas/subjects.ts"],
      "@sq/core/starter": ["../../packages/core/src/starter/index.ts"],
      "@sq/db/schema": ["../../packages/db/src/schema/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
