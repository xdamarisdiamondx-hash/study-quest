{
  "name": "study-quest",
  "version": "0.1.0",
  "private": true,
  "description": "Study Quest - a study and task-management app that guides students through Plan, Study, Understand, Practice, Quiz, Review and Improve.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @sq/web dev",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @sq/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @sq/db generate",
    "icons": "node scripts/generate-icons.mjs",
    "lan": "pnpm --filter @sq/web build && pnpm --filter @sq/web preview",
    "db:seed": "pnpm --filter @sq/server seed",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "@neondatabase/serverless": "^0.9.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^2.8.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
