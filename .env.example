# Copy to .env and adjust. .env is git-ignored — never commit real values.
# The local Node server reads DATABASE_URL from here.

# --- Database (Docker) --------------------------------------------------------
POSTGRES_DB=studyquest
POSTGRES_USER=studyquest
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://studyquest:change-me@127.0.0.1:5432/studyquest

# --- Server -------------------------------------------------------------------
PORT=4321
# "127.0.0.1" = this machine only. "0.0.0.0" = allow your phone on the same Wi-Fi
# (requires setting a LAN PIN in Settings first).
HOST=127.0.0.1

# --- File storage: Cloudflare R2 (optional) -----------------------------------
# With these unset the app stores attachments on local disk in data/files instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=studyquest
# Set to 1 only for the auto-generated r2.dev test endpoint. It is rate limited
# and not intended for real use; use a custom domain for production.
R2_USE_DEV_URL=0

# --- AI (optional) ------------------------------------------------------------
# The app works with none of these set; AI actions will offer setup guidance.
# Preferred order: local Ollama -> free cloud tier -> your own key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
